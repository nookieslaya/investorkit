      "checkConstraints": {
        "ledger_fields": {
          "name": "ledger_fields",
          "value": "(\"cash_operations\".\"kind\" IN ('DEPOSIT','WITHDRAWAL') AND \"cash_operations\".\"amount\" IS NOT NULL AND \"cash_operations\".\"instrument_id\" IS NULL AND \"cash_operations\".\"quantity\" IS NULL AND \"cash_operations\".\"unit_price\" IS NULL AND \"cash_operations\".\"commission\" IS NULL AND \"cash_operations\".\"commission_currency\" IS NULL) OR (\"cash_operations\".\"kind\" IN ('BUY','SELL') AND \"cash_operations\".\"amount\" IS NULL AND \"cash_operations\".\"instrument_id\" IS NOT NULL AND \"cash_operations\".\"quantity\" > 0 AND \"cash_operations\".\"quantity\" IS NOT NULL AND \"cash_operations\".\"unit_price\" > 0 AND \"cash_operations\".\"unit_price\" IS NOT NULL AND \"cash_operations\".\"commission\" >= 0 AND \"cash_operations\".\"commission\" IS NOT NULL AND \"cash_operations\".\"commission_currency\" = \"cash_operations\".\"currency\" AND \"cash_operations\".\"commission_currency\" IS NOT NULL)"
        },
        "cash_kind": {
          "name": "cash_kind",
          "value": "\"cash_operations\".\"kind\" IN ('DEPOSIT','WITHDRAWAL','BUY','SELL')"
        },
        "cash_currency": {
          "name": "cash_currency",
          "value": "\"cash_operations\".\"currency\" IN ('PLN','EUR','USD')"
        },
        "cash_amount_positive": {
          "name": "cash_amount_positive",
          "value": "\"cash_operations\".\"amount\" > 0"
        },
        "cash_fx_positive": {
          "name": "cash_fx_positive",
          "value": "\"cash_operations\".\"fx_to_base\" > 0"
        },
        "cash_pln_fx": {
          "name": "cash_pln_fx",
          "value": "\"cash_operations\".\"currency\" <> 'PLN' OR \"cash_operations\".\"fx_to_base\" = 1"
        },
        "cash_fx_date": {
          "name": "cash_fx_date",
          "value": "\"cash_operations\".\"fx_as_of\" <= \"cash_operations\".\"occurred_at\""
        },
        "cash_fx_source": {
          "name": "cash_fx_source",
          "value": "\"cash_operations\".\"fx_source\" = 'manual'"
        },
        "cash_note_length": {
          "name": "cash_note_length",
          "value": "char_length(\"cash_operations\".\"note\") <= 300"
        }
      },
      "isRLSEnabled": false
    },
