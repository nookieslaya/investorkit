{
  "openapi": "3.0.3",
  "info": {
    "title": "InvestorKit API",
    "version": "0.1.0",
    "description": "Wdrożone endpointy własne. /api/auth/* deleguje do Better Auth i nie jest częścią tego dokumentu. /api/v1/openapi.json udostępnia ten dokument. Planowane funkcje opisuje docs/05-api.md."
  },
  "servers": [
    {
      "url": "/",
      "description": "Ten sam origin co frontend; /health i /ready bezpośrednio na API."
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "HttpOnly session cookie w produkcji HTTPS."
      },
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Wariant dla lokalnego HTTP."
      }
    }
  },
