NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://investorkit:local_dev_only@127.0.0.1:5432/investorkit
BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# AI is not enabled in foundation; do not add OPENAI_API_KEY to VITE_*.

# Optional: local backend-only diagnostic; never use a VITE_* variable for this key.
MARKETSTACK_API_KEY=
# Hard ceiling 10; failures also consume this local diagnostic budget.
MARKETSTACK_DIAGNOSTIC_BUDGET=10
# Local tests only; NODE_ENV=production/test cannot enable external Marketstack requests.
MARKETSTACK_ENABLED=false
# Persistent application cap per UTC calendar month, across all requests/retries.
MARKETSTACK_MONTHLY_BUDGET=60
# Check the latest published session once daily, after this UTC hour, while the API runs.
# This is a conservative check time, not a guaranteed supplier publication deadline.
MARKETSTACK_DAILY_UTC_HOUR=19
